# Node 22.19+ is required. Node 24 LTS is recommended.
# Environment variables override saved console settings. Uncomment only values you want to lock.
# PORT=8901
# HOST=127.0.0.1
# Generate and apply a local certificate: npm run https:cert -- --hosts localhost,127.0.0.1,::1 --apply
# HTTPS_ENABLED=false
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key
# ALLOWED_HOSTS=device.example.com

# Private local storage. Never use shared/network storage for SQLite.
# DATA_DIR=./data
# APP_WORKSPACE=/absolute/path/my-api
# DB_FILE=./data/app.db
# Generated SQL keeps this schema name; SQLite maps it to its single main database.
# DB_APP_SCHEMA=aidot_app
# DB_SAMPLE_PREFIX=sample_
# DB_SYNCHRONOUS=FULL
# DB_BUSY_TIMEOUT_MS=250

# First setup: choose an ID/password in the local console, or run npm run admin:account.
# Existing installations: use admin:account, or sign in once with the existing key.
# The key remains available for API integrations and account recovery.
# ADMIN_TOKEN_FILE=./data/admin-token
# ADMIN_ACCOUNT_FILE=./data/admin-account.json
# ADMIN_SESSION_MINUTES=60
# ADMIN_REMEMBER_DAYS=7
# CONSOLE_LANGUAGE=en
#
# 관리 콘솔을 누구에게 열지.
#   all   (기본) 어디서나 연다 — 지금까지의 동작
#   local 서버가 도는 기기에서만 연다. /admin/* 와 콘솔 화면이 그 밖에서는
#         404 로 응답한다. 업무 API(/api/*)와 /health 는 영향받지 않는다.
# 여기에 적어두면 콘솔 설정 화면에서는 읽기 전용이 된다 — 관리자 계정이
# 털려도 콘솔을 통해 이 제한을 풀 수 없다. 상황에 따라 켜고 끄려면 이 줄을
# 지우고 콘솔 설정 화면에서 바꾸면 된다.
# 리버스 프록시 뒤에 둘 때는 프록시가 /admin/* 를 막아야 한다. 전달 헤더가
# 붙은 요청은 로컬로 보지 않으므로, 프록시를 통한 콘솔 접속은 차단된다.
# CONSOLE_ACCESS=local
# LOG_LEVEL=info
# LOG_DIR=./log
# LOG_TO_FILE=true
# LOG_MAX_BYTES=1048576
# LOG_KEEP_FILES=5
# BODY_LIMIT_BYTES=262144
# REQUEST_TIMEOUT_MS=15000
# TRACE_ENABLED=true
# TRACE_SLOW_MS=500


# Multipart requests are bounded independently of the JSON body limit.
# MULTIPART_LIMIT_BYTES=20971520
# Public images are saved in PUBLIC_DIR/uploads/images.
# Public URL: /uploads/images/<uuid>.png (not /public/uploads/...).
# PUBLIC_DIR=./public

# Product schema/seed are separate from the portable workspace.
# start:product selects this automatically; generic mini uses workspace/migrations.
# DB_MIGRATIONS_DIR=examples/product-database
UPLOAD_MAX_BYTES=20971520

# Optional GitHub release authentication; keep real tokens in local .env only.
# Contents: Read and write on the destination repository. gh is optional.
# GITHUB_TOKEN=
# GH_TOKEN=
# GH_PATH=C:\Program Files\GitHub CLI\gh.exe
