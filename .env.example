# Node 22.13+ is required. Node 24 LTS is recommended.
# Environment variables override saved console settings. Uncomment only values you want to lock.
# PORT=8901
# HOST=127.0.0.1
# Generate and apply a local certificate: npm run https:cert -- --hosts localhost,127.0.0.1,::1 --apply
# HTTPS_ENABLED=false
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key
# ALLOWED_HOSTS=device.example.com

# Private local storage. Never use shared/network storage for SQLite.
# DATA_DIR=./data
# APP_WORKSPACE=/absolute/path/my-api
# DB_FILE=./data/app.db
# Generated SQL keeps this schema name; SQLite maps it to its single main database.
# DB_APP_SCHEMA=aidot_app
# DB_SAMPLE_PREFIX=sample_
# DB_SYNCHRONOUS=FULL
# DB_BUSY_TIMEOUT_MS=250

# First setup: choose an ID/password in the local console, or run npm run admin:account.
# Existing installations: use admin:account, or sign in once with the existing key.
# The key remains available for API integrations and account recovery.
# ADMIN_TOKEN_FILE=./data/admin-token
# ADMIN_ACCOUNT_FILE=./data/admin-account.json
# ADMIN_SESSION_MINUTES=60
# ADMIN_REMEMBER_DAYS=7
# CONSOLE_LANGUAGE=en
# LOG_LEVEL=info
# LOG_DIR=./log
# LOG_TO_FILE=true
# LOG_MAX_BYTES=1048576
# LOG_KEEP_FILES=5
# BODY_LIMIT_BYTES=262144
# REQUEST_TIMEOUT_MS=15000
# TRACE_ENABLED=true
# TRACE_SLOW_MS=500

# Optional robot profile: npm run start:robot opens the setup console without these.
# Uncommenting a value locks that field in the console.
# ROBOT_ENABLED=true
# ROBOT_PROTOCOL=robaton-demo-v050
# ROBOT_ID=amr-a
# ROBATON_URL=https://fleet.example.internal
# ROBATON_API_TOKEN=<issued-controller-key>
# ROS_BRIDGE_URL=http://127.0.0.1:8912
# ROS_BRIDGE_TOKEN_FILE=/var/lib/aidot-mini/robot/bridge-token

# GitHub publishing (Full source project). Credentials are never included in source exports.
# Fill the token, or use gh auth login followed by gh auth setup-git.
GITHUB_TOKEN=
GITHUB_REPO=mike-jung/aidot-mini-full
PUBLIC_REPO=mike-jung/aidot-mini
GITHUB_BRANCH=main
PUBLIC_BRANCH=main
# Leave blank to use the existing Git user.name/user.email configuration.
GIT_USER_NAME=
GIT_USER_EMAIL=
# Publish: npm run push (Private), npm run sync:public (Public).
# Inspect locally first: npm run push:check && npm run check:public
