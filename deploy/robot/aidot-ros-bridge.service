[Unit]
Description=AiDot ROS robot action and telemetry adapter
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=aidot-mini
Group=aidot-mini
EnvironmentFile=/etc/aidot-mini/ros.env
Environment=ROS_LOG_DIR=/var/log/aidot-mini/ros
ExecStart=/opt/aidot-mini/deploy/robot/aidot-ros-bridge
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGINT
KillMode=mixed
StateDirectory=aidot-mini
LogsDirectory=aidot-mini
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=aidot-robot.target
