AIDOT_ROS_FAMILY=ros2
ROS_DISTRO=jazzy
AIDOT_ROS_OVERLAY=/opt/aidot-mini/ros
AIDOT_ROBOT_DATA_DIR=/var/lib/aidot-mini/robot
AIDOT_NAVIGATION_ACTION=navigate_to_pose
AIDOT_POSE_TOPIC=amcl_pose
AIDOT_BATTERY_TOPIC=battery_state
AIDOT_MAP_FRAME=map
AIDOT_BRIDGE_PORT=8912
# Match the existing robot ROS graph. A domain ID is not an access-control boundary.
ROS_DOMAIN_ID=0
# ROS1: change FAMILY=ros1, DISTRO=noetic, ACTION=move_base and set:
# ROS_MASTER_URI=http://127.0.0.1:11311
# ROS_IP=<this robot interface address>
