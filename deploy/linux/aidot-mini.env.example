HOST=127.0.0.1
PORT=8901
LOG_LEVEL=info
# For LAN access, enable TLS and set real certificate paths and hostnames.
# HOST=0.0.0.0
# HTTPS_ENABLED=true
# TLS_CERT_FILE=/etc/aidot-mini/server.crt
# TLS_KEY_FILE=/etc/aidot-mini/server.key
# ALLOWED_HOSTS=robot.example.internal

# Optional ROBATON v0.50 demonstration client. Start launcher with --robot.
# Leave unset to configure the profile in the robot console.
# ROBOT_ENABLED=true
# ROBOT_PROTOCOL=robaton-demo-v050
# ROBOT_ID=amr-a
# ROBATON_URL=https://fleet.example.internal
# ROBATON_API_TOKEN=<provision securely; at least 12 characters>
# ROS_BRIDGE_URL=http://127.0.0.1:8912
# ROS_BRIDGE_TOKEN_FILE=/var/lib/aidot-mini/robot/bridge-token
