{
  "name": "aidot-mini",
  "version": "1.0.7",
  "description": "Lightweight aidot-express annotation-compatible workspace runtime",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node scripts/watch-workspace.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "verify": "npm run check && npm run contract:check && npm test && npm run product:verify",
    "workspace:init": "node scripts/init-workspace.mjs",
    "workspace:compile": "node scripts/compile-workspace.mjs",
    "android:assets": "python3 android/scripts/build-assets.py",
    "android:check": "python3 android/scripts/check-android.py",
    "admin:token": "node scripts/admin-token.mjs",
    "cert:dev": "node scripts/dev-cert.mjs",
    "port:export": "node scripts/export-module.mjs",
    "android:runtime": "python3 android/scripts/check-runtime.py",
    "build:linux": "python3 scripts/build-linux.py",
    "build:ros": "python3 scripts/build-ros.py",
    "start:robot": "node modules/robot-client/main.mjs",
    "test:ros": "python3 -m unittest discover -s tests/ros -v",
    "admin:account": "node scripts/admin-account.mjs",
    "https:cert": "node scripts/dev-cert.mjs",
    "db:migrate": "node scripts/migrate-workspace.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "api:verify": "node scripts/smoke-note.mjs",
    "build:starter": "python3 scripts/build-starter.py",
    "test:console": "node --test tests/console-workspace.test.mjs",
    "test:browser": "node scripts/browser-note-qa.mjs",
    "start:product": "node scripts/start-product.mjs",
    "product:account": "node scripts/start-product.mjs --account",
    "product:verify": "node scripts/verify-product.mjs",
    "test:product": "node scripts/verify-product.mjs",
    "product:contract": "node scripts/verify-product-contract.mjs",
    "workspace:verify": "node scripts/verify-workspace.mjs"
  },
  "dependencies": {
    "esbuild-wasm": "0.28.2"
  },
  "license": "Apache-2.0",
  "author": "Aidot Link Co., Ltd. <mike.jung.global@gmail.com>",
  "private": true,
  "aidotEdition": "public",
  "repository": {
    "type": "git",
    "url": "https://github.com/mike-jung/aidot-mini.git"
  }
}
